# lab.env — SINGLE SOURCE of the lab topology.
#
# Read by the Vagrantfile AND by kubeadm/cluster-up.sh AND by the _k8s/*-up.sh scripts:
# nothing left to "keep aligned by hand" between the three layers.
#
# Copy this template, then edit your topology locally (lab.env is gitignored):
#     cp lab.env.example lab.env
#
# STRICT format: one KEY=value assignment per line, no space around the `=` and no `;`.
# A real environment variable still wins, which allows one-off overrides:
#     WORKERS=5 vagrant up

# =============================================================================
# 1. Versions
# =============================================================================

# The Kubernetes version INSTALLED (kubelet/kubeadm/kubectl packages, pinned + held).
# It must exist in the pkgs.k8s.io apt repo of the K8S_APT_MINOR minor below.
K8S_VERSION=1.36.3

# Minor of the pkgs.k8s.io apt repo (`https://pkgs.k8s.io/core:/stable:/<minor>/deb/`).
# It must match K8S_VERSION: v1.36 for a K8S_VERSION in 1.36.x.
# THIS pair is what you bump for an upgrade (see kubeadm/UPGRADE.md).
K8S_APT_MINOR=v1.36

# Where containerd comes from:
#   docker   DEFAULT. The `containerd.io` package from the Docker apt repo => containerd 2.x.
#            Only containerd 2.x implements the CRI `RuntimeConfig` method that kubeadm uses
#            to detect the cgroup driver. On 1.36 that is a preflight WARNING, the fallback
#            disappears in 1.37: containerd 1.7 is a dead end.
#   debian   Debian 13's `containerd` package (1.7.x). Depends on no third-party repo, but
#            it is the 1.7 LTS branch, which will NEVER get `RuntimeConfig`
#            (containerd#11346 closed without a merge). Reserve it for an offline lab.
CONTAINERD_SOURCE=docker

# Full system upgrade at provisioning time (`apt-get upgrade`).
#
#   true   DEFAULT. Every VM is upgraded before Kubernetes is installed. A Debian box is
#          often several weeks behind, security fixes included.
#   false  Skip the upgrade. `vagrant up` is markedly faster and no longer depends on the
#          Debian mirrors — useful offline or to rebuild quickly.
#
# ⚠️ It is `upgrade` and NEVER `full-upgrade`: `upgrade` cannot install a package under a
#    new name, so it leaves kernel bumps aside by itself (`linux-image-6.12.x` is a new
#    package name). The kernel does not change under the feet of the modules loaded right
#    after, and no reboot is forced.
#
# ⚠️ `grub-pc` is preseeded by `debconf-set-selections` BEFORE the upgrade: without that,
#    its postinst asks a debconf question ("on which disk should GRUB be installed?") that
#    has no terminal to show up on and blocks `vagrant up` until the timeout.
#    See kubeadm/provision.sh step 2.
SYSTEM_UPGRADE=true

# Registry mirror (a Harbor-style pull-through proxy). EMPTY = we pull straight from
# docker.io / registry.k8s.io. When set, the value feeds
# /etc/containerd/certs.d/docker.io/hosts.toml on every node.
# Example: REGISTRY_MIRROR=https://reg.example.com/v2/proxy
REGISTRY_MIRROR=

# =============================================================================
# 2. Topology
# =============================================================================

# 1 = single control plane; 3 = HA (etcd quorum). 2 is a TRAP: etcd then tolerates no
# failure at all while doubling the cost. Stay on 1 or 3 (or 5).
CONTROL_PLANES=1

# Number of workers. 0 is accepted: the control planes are then "untainted"
# (see UNTAINT_CP below) so that pods can be scheduled on them.
WORKERS=2

# Resources per role. The kubeadm preflight requires 2 vCPU and ~1700 MiB on a control
# plane; 2048 passes but leaves only ~350 MiB of headroom to a stacked etcd. 3072 is the
# real comfortable floor, and `_k8s/observability/` asks for 4096.
CP_MEM=3072
CP_CPU=2
WK_MEM=2048
WK_CPU=2

# Cost of the default topology (1 CP + 2 workers): 7 GB of RAM, 6 vCPU.
# Full HA topology (3 CP + 3 workers): 3x3072 + 3x2048 = 15.4 GB, 12 vCPU.

# Vagrant box. The lab is written and tested for Debian 13 (Trixie).
BOX=bento/debian-13

# Prefix of the VM names: <prefix>-cp1, <prefix>-cp2… and <prefix>-w1, <prefix>-w2…
NODE_PREFIX=k8s

# Cluster name (kubeadm `clusterName` + kubeconfig context).
CLUSTER_NAME=kubeadm-lab

# =============================================================================
# 3. Network
# =============================================================================

# VirtualBox host-only network (the first 3 octets).
NETWORK=192.168.56

# Kubernetes API VIP = `controlPlaneEndpoint`. Carried by keepalived (VRRP) on the control
# planes — why keepalived rather than kube-vip is explained in the README, "Under the hood"
# section.
#
# ⚠️ It is set EVEN with CONTROL_PLANES=1, and that is deliberate: `controlPlaneEndpoint` is
#    frozen into the certificates and the kubeconfig at `kubeadm init` time. If it pointed
#    at cp1's real IP, going from 1 to 3 control planes later would require regenerating
#    everything. With the VIP from the start, adding a CP is a plain `join`.
VIP=192.168.56.5

# Addressing scheme:
#   control plane i -> NETWORK.(CP_IP_START + (i-1)*CP_IP_STEP)  => .10, .20, .30…
#   worker       i  -> NETWORK.(WK_IP_START + (i-1)*WK_IP_STEP)  => .101, .102, .103…
CP_IP_START=10
CP_IP_STEP=10
WK_IP_START=101
WK_IP_STEP=1

# Pod CIDR (kubeadm `networking.podSubnet`).
# ⚠️ The CNI must announce THE SAME CIDR. Cilium, in cluster-pool mode, defaults to
#    10.0.0.0/8, unrelated to whatever is declared here: _k8s/cilium/cilium-up.sh passes
#    POD_CIDR to it explicitly. Two diverging values = broken pod network.
POD_CIDR=10.244.0.0/16

# Service CIDR (kubeadm `networking.serviceSubnet`).
SERVICE_CIDR=10.96.0.0/12

# Host-only range reserved for LoadBalancer Services (L2/ARP announcement by Cilium).
# Outside the node range (.10/.20/.30 and .101+) and outside the VIP (.5).
#
# ⚠️ THE FIRST IP OF THE RANGE IS THE ONE THE ENVOY GATEWAY TAKES: that is the one the
#    wildcard DNS record `*.<LAB_DOMAIN>` must point at. See README.md §6.
LB_POOL_START=192.168.56.200
LB_POOL_END=192.168.56.230

# keepalived VRRP group ID (1-255). Change it only if ANOTHER keepalived lab runs on the
# same host-only network: two groups with the same ID fight over the VIP.
VRRP_ROUTER_ID=51

# =============================================================================
# 4. CNI
# =============================================================================

# Who lays down the pod network — read by kubeadm/cluster-up.sh AND _k8s/platform-up.sh.
#
#   cilium   THE REPO DEFAULT. The only "everything on" choice: it is the only one that
#            gives LoadBalancer Services an EXTERNAL-IP (L2/ARP announcement), hence the
#            HTTPS UIs.
#   calico   CNI only. ⚠️ Calico does NOT announce LoadBalancer Service IPs (BGP only, and
#            there is no peer router on a host-only network): you ALSO need MetalLB.
#            See _k8s/calico/README.md.
#   flannel  CNI only, minimal. No LoadBalancer Service at all: the _k8s/ layer (Gateway,
#            HTTPS UIs) is unusable.
#   none     Nobody lays anything down: you install your CNI by hand.
#
# Switching CNI on an existing cluster is NOT supported: `vagrant destroy` first.
CNI=cilium

# Cilium chart version (ignored when CNI != cilium).
CILIUM_VERSION=1.20.0

# Replacing kube-proxy with eBPF (Cilium only).
#
#   true   DEFAULT. cluster-up.sh runs `kubeadm init --skip-phases=addon/kube-proxy` and
#          Cilium handles Services in eBPF. This is the state of the art.
#   false  kube-proxy is installed normally, and Cilium goes on top of it.
#
# ⚠️ Requires CNI=cilium. With calico/flannel/none, cluster-up.sh REFUSES to start:
#    without kube-proxy and without a replacement, no Service works.
KUBE_PROXY_REPLACEMENT=true

# Remove the `node-role.kubernetes.io/control-plane:NoSchedule` taint from the control
# planes, so that application pods can be scheduled there.
#
#   auto   DEFAULT. Untainted only when WORKERS=0 (otherwise nothing could run).
#   true   Always untainted — handy on a workstation with little RAM.
#   false  Never. Control planes strictly reserved for the system.
UNTAINT_CP=auto


# =============================================================================
# 5. Domain and TLS of the lab UIs
# =============================================================================

# Domain of the lab UIs (wildcard TLS + HTTPRoute). This repo is public, so the versioned
# default is NEUTRAL. Put YOUR domain here; the `*-up.sh` scripts substitute it on the fly
# in the manifests.
LAB_DOMAIN=kubeadm.lab.example.io

# TLS MODE of the UIs — read by _k8s/platform-up.sh.
#
#   true   SELF-SIGNED (default). platform-up.sh builds a local CA and a wildcard
#          `*.<LAB_DOMAIN>` certificate with `openssl`, loads it into the Gateway, and does
#          NOT install cert-manager. No token, no DNS-01 challenge, no quota, no publicly
#          resolvable domain: it works offline. In exchange, the browser warns until the CA
#          (`_out/self-signed/ca.crt`) is imported. See _k8s/self-signed/README.md.
#   false  cert-manager + Let's Encrypt (ACME DNS-01 through Cloudflare). Requires a REAL
#          LAB_DOMAIN whose zone you control, plus CLOUDFLARE_API_TOKEN below.
SELF_SIGNED=true

# --- The four variables below are only used when SELF_SIGNED=false -----------------

# DNS zone hosting LAB_DOMAIN (the ACME ClusterIssuer's `dnsZones` selector and the scope of
# the Cloudflare token). Empty => the last two labels of LAB_DOMAIN (e.g. `example.io`).
# Only set it when the inference is wrong (e.g. `co.uk`).
LAB_DNS_ZONE=

# E-mail of the Let's Encrypt ACME account (expiry notifications). Empty => admin@<zone>.
LAB_ACME_EMAIL=

# ACME issuer: `staging` (default) or `prod`.
#
#   staging  UNTRUSTED certificate (browser warning), quota ~30,000/week.
#            The right default for a lab you destroy and rebuild.
#   prod     publicly trusted certificate, but a LET'S ENCRYPT QUOTA OF 5 CERTIFICATES PER
#            WEEK for a given `*.<LAB_DOMAIN>`.
#
# ⚠️ The wildcard lives ONLY in etcd: every `vagrant destroy` destroys it and the rebuild
#    asks for a fresh one. On `prod`, 5 rebuilds within the week exhaust the quota and the
#    lab stays WITHOUT TLS until the end of the 168 h window (error 429).
LAB_ACME_ISSUER=staging

# Cloudflare API token for cert-manager's DNS-01 (permissions Zone:DNS:Edit +
# Zone:Zone:Read on the zone). Leave it EMPTY here: the real value goes into lab.env
# (gitignored), never into this versioned template.
CLOUDFLARE_API_TOKEN=
