# lab.env — SOURCE UNIQUE de la topologie du lab.
#
# Lu par le Vagrantfile ET par kubeadm/cluster-up.sh ET par les scripts _k8s/*-up.sh :
# plus rien à « garder aligné à la main » entre les trois couches.
#
# Copie ce modèle puis édite ta topologie en local (lab.env est gitignoré) :
#     cp lab.env.example lab.env
#
# Format STRICT : une affectation KEY=value par ligne, sans espace autour du `=`
# et sans `;`. Une vraie variable d'environnement reste prioritaire, ce qui permet
# les surcharges ponctuelles :  WORKERS=5 vagrant up

# =============================================================================
# 1. Versions
# =============================================================================

# Version Kubernetes INSTALLÉE (paquets kubelet/kubeadm/kubectl, épinglés + hold).
# Doit exister dans le dépôt apt pkgs.k8s.io de la mineure K8S_APT_MINOR ci-dessous.
K8S_VERSION=1.36.3

# Mineure du dépôt apt pkgs.k8s.io (`https://pkgs.k8s.io/core:/stable:/<minor>/deb/`).
# Doit correspondre à K8S_VERSION : v1.36 pour un K8S_VERSION en 1.36.x.
# C'est CE couple qu'on incrémente pour une montée de version (cf. kubeadm/UPGRADE.md).
K8S_APT_MINOR=v1.36

# D'où vient containerd :
#   docker   DÉFAUT. Paquet `containerd.io` du dépôt apt Docker => containerd 2.x.
#            Seul containerd 2.x implémente la méthode CRI `RuntimeConfig` dont kubeadm
#            se sert pour détecter le cgroup driver. En 1.36 c'est un AVERTISSEMENT au
#            preflight, le repli disparaît en 1.37 : containerd 1.7 est une impasse.
#   debian   Paquet `containerd` de Debian 13 (1.7.x). Ne dépend d'aucun dépôt tiers,
#            mais c'est la branche LTS 1.7 qui n'aura JAMAIS `RuntimeConfig`
#            (containerd#11346 fermé sans merge). À réserver à un lab hors-ligne.
CONTAINERD_SOURCE=docker

# Mise à jour complète du système au provisioning (`apt-get upgrade`).
#
#   true   DÉFAUT. Chaque VM est mise à jour avant l'installation de Kubernetes. Une box
#          Debian a souvent plusieurs semaines de retard, correctifs de sécurité compris.
#   false  On saute la mise à jour. `vagrant up` est nettement plus rapide et ne dépend
#          plus des miroirs Debian — utile hors-ligne ou pour reconstruire vite.
#
# ⚠️ C'est `upgrade` et JAMAIS `full-upgrade` : `upgrade` ne peut pas installer un paquet
#    au nom nouveau, donc il écarte de lui-même les montées de noyau
#    (`linux-image-6.12.x` est un nouveau nom de paquet). Le noyau ne change pas sous les
#    pieds des modules qu'on charge juste après, et aucun reboot n'est imposé.
#
# ⚠️ `grub-pc` est préconfiguré par `debconf-set-selections` AVANT la mise à jour : sans
#    ça, son postinst pose une question debconf (« sur quel disque installer GRUB ? »)
#    qui n'a aucun terminal où s'afficher et bloque `vagrant up` jusqu'au timeout.
#    Cf. kubeadm/provision.sh étape 2.
SYSTEM_UPGRADE=true

# Miroir de registry (proxy pull-through type Harbor). VIDE = on tire directement
# depuis docker.io / registry.k8s.io. Renseigné, la valeur alimente
# /etc/containerd/certs.d/docker.io/hosts.toml sur chaque node.
# Exemple : REGISTRY_MIRROR=https://reg.example.com/v2/proxy
REGISTRY_MIRROR=

# =============================================================================
# 2. Topologie
# =============================================================================

# 1 = control plane unique ; 3 = HA (quorum etcd). 2 est un PIÈGE : etcd ne tolère
# alors aucune panne tout en doublant le coût. Reste sur 1 ou 3 (ou 5).
CONTROL_PLANES=1

# Nombre de workers. 0 est accepté : les control planes sont alors « déteintés »
# (cf. UNTAINT_CP ci-dessous) pour que les pods puissent s'y planifier.
WORKERS=2

# Ressources par rôle. Le preflight kubeadm exige 2 vCPU et ~1700 Mio sur un control
# plane ; 2048 passe mais ne laisse que ~350 Mio de marge à un etcd empilé. 3072 est
# le vrai plancher confortable, et `_k8s/observability/` réclame 4096.
CP_MEM=3072
CP_CPU=2
WK_MEM=2048
WK_CPU=2

# Coût de la topologie par défaut (1 CP + 2 workers) : 7 Go de RAM, 6 vCPU.
# Topologie HA complète (3 CP + 3 workers) : 3x3072 + 3x2048 = 15,4 Go, 12 vCPU.

# Box Vagrant. Le lab est écrit et testé pour Debian 13 (Trixie).
BOX=bento/debian-13

# Préfixe des noms de VM : <prefix>-cp1, <prefix>-cp2… et <prefix>-w1, <prefix>-w2…
NODE_PREFIX=k8s

# Nom du cluster (kubeadm `clusterName` + contexte kubeconfig).
CLUSTER_NAME=kubeadm-lab

# =============================================================================
# 3. Réseau
# =============================================================================

# Réseau host-only VirtualBox (les 3 premiers octets).
NETWORK=192.168.56

# VIP de l'API Kubernetes = `controlPlaneEndpoint`. Portée par keepalived (VRRP) sur
# les control planes — le pourquoi de keepalived plutôt que kube-vip est dans le README,
# section « Sous le capot ».
#
# ⚠️ Elle est posée MÊME avec CONTROL_PLANES=1, et c'est volontaire : `controlPlaneEndpoint`
#    est figé dans les certificats et le kubeconfig au moment du `kubeadm init`. Si on
#    pointait sur l'IP réelle de cp1, passer plus tard de 1 à 3 control planes imposerait
#    de tout régénérer. Avec la VIP dès le départ, ajouter un CP est un simple `join`.
VIP=192.168.56.5

# Plan d'adressage :
#   control plane i -> NETWORK.(CP_IP_START + (i-1)*CP_IP_STEP)  => .10, .20, .30…
#   worker       i  -> NETWORK.(WK_IP_START + (i-1)*WK_IP_STEP)  => .101, .102, .103…
CP_IP_START=10
CP_IP_STEP=10
WK_IP_START=101
WK_IP_STEP=1

# CIDR des pods (kubeadm `networking.podSubnet`).
# ⚠️ Le CNI doit annoncer LE MÊME CIDR. Cilium, en mode cluster-pool, part par défaut
#    sur 10.0.0.0/8 sans aucun rapport avec ce qu'on déclare ici : _k8s/cilium/cilium-up.sh
#    lui repasse POD_CIDR explicitement. Deux valeurs divergentes = réseau pod cassé.
POD_CIDR=10.244.0.0/16

# CIDR des Services (kubeadm `networking.serviceSubnet`).
SERVICE_CIDR=10.96.0.0/12

# Plage host-only réservée aux Services LoadBalancer (annonce L2/ARP par Cilium).
# En dehors de la plage des nodes (.10/.20/.30 et .101+) et de la VIP (.5).
#
# ⚠️ LA PREMIÈRE IP DE LA PLAGE EST CELLE QUE PREND LE GATEWAY ENVOY : c'est elle que
#    doit viser l'enregistrement DNS wildcard `*.<LAB_DOMAIN>`. Cf. README.md §6.
LB_POOL_START=192.168.56.200
LB_POOL_END=192.168.56.230

# ID du groupe VRRP keepalived (1-255). À changer seulement si un AUTRE lab keepalived
# tourne sur le même réseau host-only : deux groupes avec le même ID se battent pour la VIP.
VRRP_ROUTER_ID=51

# =============================================================================
# 4. CNI
# =============================================================================

# Qui pose le réseau des pods — lu par kubeadm/cluster-up.sh ET _k8s/platform-up.sh.
#
#   cilium   DÉFAUT DU DÉPÔT. Le seul choix « tout allumé » : c'est le seul qui donne
#            une EXTERNAL-IP aux Services LoadBalancer (annonce L2/ARP), donc les UI HTTPS.
#   calico   CNI seul. ⚠️ Calico n'annonce PAS les IP de Service LoadBalancer (BGP
#            uniquement, et il n'y a aucun routeur pair sur un réseau host-only) : il
#            faut EN PLUS MetalLB. Cf. _k8s/calico/README.md.
#   flannel  CNI seul, minimaliste. Aucun Service LoadBalancer : la couche _k8s/
#            (Gateway, UI HTTPS) est inutilisable.
#   none     Personne ne pose rien : tu installes ton CNI à la main.
#
# Changer de CNI sur un cluster existant n'est PAS supporté : `vagrant destroy` d'abord.
CNI=cilium

# Version du chart Cilium (ignorée si CNI != cilium).
CILIUM_VERSION=1.20.0

# Remplacement de kube-proxy par eBPF (Cilium uniquement).
#
#   true   DÉFAUT. cluster-up.sh lance `kubeadm init --skip-phases=addon/kube-proxy`
#          et Cilium prend en charge les Services en eBPF. C'est l'état de l'art.
#   false  kube-proxy est installé normalement, Cilium se pose par-dessus.
#
# ⚠️ Exige CNI=cilium. Avec calico/flannel/none, cluster-up.sh REFUSE de démarrer :
#    sans kube-proxy et sans remplaçant, aucun Service ne fonctionne.
KUBE_PROXY_REPLACEMENT=true

# Retirer le taint `node-role.kubernetes.io/control-plane:NoSchedule` des control planes,
# pour que les pods applicatifs puissent s'y planifier.
#
#   auto   DÉFAUT. Déteinté seulement si WORKERS=0 (sinon rien ne pourrait tourner).
#   true   Toujours déteinté — pratique sur un poste avec peu de RAM.
#   false  Jamais. Control planes strictement réservés au système.
UNTAINT_CP=auto


# =============================================================================
# 5. Domaine et TLS des UI du lab
# =============================================================================

# Domaine des UI du lab (wildcard TLS + HTTPRoute). Ce dépôt est public : le défaut
# versionné est donc NEUTRE. Mets TON domaine ici, les scripts `*-up.sh` le substituent
# à la volée dans les manifestes.
LAB_DOMAIN=kubeadm.lab.example.io

# MODE TLS des UI — lu par _k8s/platform-up.sh.
#
#   true   AUTO-SIGNÉ (défaut). platform-up.sh fabrique une AC locale et un certificat
#          wildcard `*.<LAB_DOMAIN>` avec `openssl`, le charge dans la Gateway, et
#          n'installe PAS cert-manager. Aucun token, aucun challenge DNS-01, aucun quota,
#          aucun domaine publiquement résolvable : ça marche hors-ligne. En contrepartie
#          le navigateur avertit tant que l'AC (`_out/self-signed/ca.crt`) n'est pas
#          importée. Cf. _k8s/self-signed/README.md.
#   false  cert-manager + Let's Encrypt (ACME DNS-01 via Cloudflare). Exige un LAB_DOMAIN
#          RÉEL dont tu contrôles la zone, plus CLOUDFLARE_API_TOKEN ci-dessous.
SELF_SIGNED=true

# --- Les quatre variables suivantes ne servent QUE si SELF_SIGNED=false ------------

# Zone DNS hébergeant LAB_DOMAIN (sélecteur `dnsZones` du ClusterIssuer ACME et portée
# du token Cloudflare). Vide => les deux derniers labels de LAB_DOMAIN (ex. `example.io`).
# À ne renseigner que si l'inférence est fausse (ex. `co.uk`).
LAB_DNS_ZONE=

# E-mail du compte ACME Let's Encrypt (notifications d'expiration). Vide => admin@<zone>.
LAB_ACME_EMAIL=

# Émetteur ACME : `staging` (défaut) ou `prod`.
#
#   staging  certificat NON trusté (avertissement navigateur), quota ~30 000/semaine.
#            Le bon défaut pour un lab qu'on détruit et reconstruit.
#   prod     certificat publiquement trusté, mais QUOTA LET'S ENCRYPT DE 5 CERTIFICATS
#            PAR SEMAINE pour un `*.<LAB_DOMAIN>` donné.
#
# ⚠️ Le wildcard ne vit QUE dans etcd : chaque `vagrant destroy` le détruit et la
#    reconstruction en redemande un neuf. En `prod`, 5 reconstructions dans la semaine
#    épuisent le quota et le lab reste SANS TLS jusqu'à la fin de la fenêtre de 168 h
#    (erreur 429).
LAB_ACME_ISSUER=staging

# Token API Cloudflare pour le DNS-01 de cert-manager (permissions Zone:DNS:Edit +
# Zone:Zone:Read sur la zone). Laisse-le VIDE ici : la vraie valeur va dans lab.env
# (gitignoré), jamais dans ce modèle versionné.
CLOUDFLARE_API_TOKEN=
